# Copy to .env and fill in. Real environment variables override this file.

NODE_ENV=development
PORT=3000
# Public URL of the site – used for payment return URLs. Must be https in production.
BASE_URL=http://localhost:3000
# DATA_DIR=./data

# ---------------------------------------------------------------- AI
# Claude API key from https://console.anthropic.com . Without it, development
# runs a clearly-labelled offline DEMO AI; production disables AI.
ANTHROPIC_API_KEY=
# AI_MODEL=claude-opus-5-5
# AI_EFFORT=medium
# AI_PROVIDER=anthropic        # anthropic | mock (dev only) | none

# ---------------------------------------------------------- Payments
# PayPal Checkout – supports Israeli merchants and ILS. Create a REST app at
# https://developer.paypal.com/dashboard/applications and a webhook pointing to
#   {BASE_URL}/api/payments/webhooks/paypal
# subscribed to: CHECKOUT.ORDER.APPROVED, PAYMENT.CAPTURE.COMPLETED,
# PAYMENT.CAPTURE.DENIED, PAYMENT.CAPTURE.REFUNDED, PAYMENT.CAPTURE.REVERSED
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
PAYPAL_MODE=sandbox             # sandbox | live
# PAYMENT_PROVIDER=paypal       # paypal | test (dev only) | none
# TEST_WEBHOOK_SECRET=          # optional fixed secret for test-mode webhooks

# --------------------------------------------------------------- Limits
# MAX_PROJECTS_PER_USER=1
# PRICING_FILE=./config/pricing.json
