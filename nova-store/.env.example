# Copy to .env.local and fill in values from Supabase → Project Settings → API.
# Public values (safe for the browser; protected by Row Level Security):
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Absolute URL of this app, used in auth email redirect links.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# SERVER ONLY. Never prefix with NEXT_PUBLIC_ and never import in client code.
# Not required for Phase 1; reserved for admin tasks and webhooks.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
